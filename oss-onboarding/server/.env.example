MONGODB_URI=mongodb://127.0.0.1:27017/oss_onboarding
SESSION_SECRET=change-this-to-a-very-secure-random-secret-key
CLIENT_ORIGIN=http://localhost:5173
OLLAMA_URL=http://localhost:11434
CHAT_MODEL=llama3.1:8b
EMBED_MODEL=nomic-embed-text
PORT=5000
NODE_ENV=development

# Email (optional). Leave SMTP_URL empty to print verification/reset links in the server log instead.
SMTP_URL=
MAIL_FROM=Contributor Onboarding <no-reply@localhost>
# true = users must verify their email before logging in (recommended for production)
REQUIRE_EMAIL_VERIFICATION=false

# Set true after running `npm run embed-issues` (needs the Atlas issues_vector_index and Ollama running)
ISSUE_VECTOR_SEARCH=false
